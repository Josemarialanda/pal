-- Malformed definitions are rejected, with a reason.

type Bool
type Arrow<a, b>
type Pair<a, a>                -- a parameter listed twice

expr True : Bool
expr Not  : Arrow<Bol, Bool>   -- a typo: did you mean Bool?
expr Id   : Arrow<Bool>        -- too few type arguments
expr X    : Thing              -- never declared

-- A premise variable that the conclusion does not bind.
rule Weird:
  z : Bool
->
  W(x) : Bool

-- Rules that were rejected are not there to use.
fails W(True)
fails Not

-- Definitions: the body must have a type, and the name must be new.
def Bad := Weird(True)
def True := True

-- These are warnings: the definition is added. A rule can hide an older one,
-- and reductions can be not confluent or not terminate.
expr False : Bool

rule IsTrue:
  b : Bool
->
  IsTrue(b) : Bool

rule IsTrueAgain:
  b : Bool
->
  IsTrue(b) : Bool

reduce IsTrueTrue: IsTrue(True) ~> True
reduce IsTrueAny:  IsTrue(b) ~> False   -- not confluent with IsTrueTrue
reduce Forever:    IsTrue(b) ~> IsTrue(b)   -- does not terminate

-- Definitions with parameters.
def Twice(b, b) := b
def NotBool(b) := Weird(b)
