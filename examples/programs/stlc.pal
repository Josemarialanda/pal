-- A fragment of the Simply Typed Lambda Calculus.
-- Lowercase type names (a, b) are type variables, solved by unification.

type Num
type Bool
type Arrow<a, b>

expr LitInt : Num
expr True   : Bool
expr False  : Bool

-- Built-in functions, given their function types directly.
expr Not    : Arrow<Bool, Bool>
expr IsZero : Arrow<Num, Bool>

rule If:
  cond : Bool
  then : a
  else : a
->
  If(cond, then, else) : a

-- Application: a function a -> b applied to an a gives a b.
rule App:
  f : Arrow<a, b>
  x : a
->
  App(f, x) : b

-- Lambda: the body is checked with the parameter x in scope.
rule Lam:
  x : a |- body : b
->
  Lam(x, body) : Arrow<a, b>

-- Let: the bound value is checked first; then the body, with x in scope.
rule Let:
  value : a
  x : a |- body : b
->
  Let(x, value, body) : b

check App(Not, True) : Bool
check If(App(IsZero, LitInt), LitInt, LitInt) : Num
check Lam(x, x) : Arrow<a, a>
check Lam(x, App(Not, x)) : Arrow<Bool, Bool>
check Lam(f, Lam(x, App(f, App(f, x)))) : Arrow<Arrow<a, a>, Arrow<a, a>>
check App(Lam(x, If(x, LitInt, LitInt)), True) : Num
check Let(n, LitInt, App(IsZero, n)) : Bool
check Lam(x, Lam(x, x)) : Arrow<a, Arrow<b, b>>  -- inner x shadows
fails App(Not, LitInt)  -- Not expects Bool
fails App(Lam(x, App(Not, x)), LitInt)  -- the lambda expects Bool
fails Lam(x, App(x, x))  -- infinite type
fails Lam(x, y)  -- y is not in scope
