-- Typed arithmetic expressions (Pierce, "Types and Programming Languages", ch. 8).
-- The smallest interesting type system: two types and seven term forms.

type Bool
type Nat

expr True  : Bool
expr False : Bool
expr Zero  : Nat

rule If:
  cond : Bool
  then : t
  else : t
->
  If(cond, then, else) : t

rule Succ:
  n : Nat
->
  Succ(n) : Nat

rule Pred:
  n : Nat
->
  Pred(n) : Nat

rule IsZero:
  n : Nat
->
  IsZero(n) : Bool

check Succ(Succ(Zero)) : Nat
check IsZero(Pred(Succ(Zero))) : Bool
check If(IsZero(Zero), Succ(Zero), Zero) : Nat
check If(False, True, IsZero(Succ(Zero))) : Bool

-- Expected failures:
fails Succ(True)  -- True is not a Nat
fails If(Zero, True, False)  -- the condition must be Bool
fails If(True, Zero, False)  -- the branches differ
