-- The simply typed lambda calculus extended with unit, products, sums and
-- general recursion (Pierce, TAPL ch. 11).

type Unit
type Bool
type Nat
type Arrow<a, b>
type Prod<a, b>
type Sum<a, b>

expr Tt    : Unit
expr True  : Bool
expr False : Bool
expr Zero  : Nat
expr Succ  : Arrow<Nat, Nat>

rule Lam:
  x : a |- body : b
->
  Lam(x, body) : Arrow<a, b>

rule App:
  f : Arrow<a, b>
  x : a
->
  App(f, x) : b

-- Products: a pair and its two projections.
rule Pair:
  x : a
  y : b
->
  Pair(x, y) : Prod<a, b>

rule Fst:
  p : Prod<a, b>
->
  Fst(p) : a

rule Snd:
  p : Prod<a, b>
->
  Snd(p) : b

-- Sums: inject left or right, and eliminate with Case.
-- Each branch binds its own variable (x or y) while it is checked.
rule Inl:
  x : a
->
  Inl(x) : Sum<a, b>

rule Inr:
  x : b
->
  Inr(x) : Sum<a, b>

rule Case:
  s : Sum<a, b>
  x : a |- left : c
  y : b |- right : c
->
  Case(s, x, left, y, right) : c

-- General recursion: the fixed point of a function a -> a.
rule Fix:
  f : Arrow<a, a>
->
  Fix(f) : a

check Lam(p, Pair(Snd(p), Fst(p))) : Arrow<Prod<a, b>, Prod<b, a>>  -- swap
check Case(Inl(Zero), n, App(Succ, n), b, Zero) : Nat
check Lam(s, Case(s, x, Inr(x), y, Inl(y))) : Arrow<Sum<a, b>, Sum<b, a>>
check Lam(u, Pair(u, Tt)) : Arrow<a, Prod<a, Unit>>
check Fix(Lam(f, Lam(n, App(f, n)))) : Arrow<a, b>  -- a looping function

-- Expected failures:
fails Case(Inl(Zero), n, App(Succ, n), b, True)  -- the branches differ
fails Fst(Inl(Zero))  -- a sum is not a product
fails Fix(Zero)  -- Fix needs a function
