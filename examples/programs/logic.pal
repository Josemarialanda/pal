-- Propositional logic via the Curry–Howard correspondence:
-- types are propositions, terms are proofs. `infer p` returns the
-- proposition that the proof term p proves, and `check p : P` checks that
-- p is a proof of P.
--
--   Implies<A, B>   A → B      Lam / App      (→ intro / elim)
--   And<A, B>       A ∧ B      Pair / Fst / Snd
--   Or<A, B>        A ∨ B      Inl / Inr / Case
--   False           ⊥          Absurd         (ex falso quodlibet)

type Implies<a, b>
type And<a, b>
type Or<a, b>
type False

rule Lam:
  x : a |- body : b
->
  Lam(x, body) : Implies<a, b>

rule App:
  f : Implies<a, b>
  x : a
->
  App(f, x) : b

rule Pair:
  x : a
  y : b
->
  Pair(x, y) : And<a, b>

rule Fst:
  p : And<a, b>
->
  Fst(p) : a

rule Snd:
  p : And<a, b>
->
  Snd(p) : b

rule Inl:
  x : a
->
  Inl(x) : Or<a, b>

rule Inr:
  x : b
->
  Inr(x) : Or<a, b>

rule Case:
  s : Or<a, b>
  x : a |- left : c
  y : b |- right : c
->
  Case(s, x, left, y, right) : c

rule Absurd:
  p : False
->
  Absurd(p) : a

-- A → A
check Lam(x, x) : Implies<a, a>
-- A ∧ B → B ∧ A
check Lam(p, Pair(Snd(p), Fst(p))) : Implies<And<a, b>, And<b, a>>
-- A ∨ B → B ∨ A
check Lam(s, Case(s, x, Inr(x), y, Inl(y))) : Implies<Or<a, b>, Or<b, a>>
-- (A → B) → (B → C) → (A → C)
check Lam(f, Lam(g, Lam(x, App(g, App(f, x))))) : Implies<Implies<a, b>, Implies<Implies<b, c>, Implies<a, c>>>
-- (A ∧ B → C) → (A → B → C)          currying
check Lam(f, Lam(a, Lam(b, App(f, Pair(a, b))))) : Implies<Implies<And<a, b>, c>, Implies<a, Implies<b, c>>>
-- A ∧ (B ∨ C) → (A ∧ B) ∨ (A ∧ C)    distributivity
check Lam(p, Case(Snd(p), b, Inl(Pair(Fst(p), b)), c, Inr(Pair(Fst(p), c)))) : Implies<And<a, Or<b, c>>, Or<And<a, b>, And<a, c>>>
-- ⊥ → A
check Lam(f, Absurd(f)) : Implies<False, a>

-- (A → B ∧ C) → (A → B)              unification works out x's proposition
check Lam(x, Lam(y, Fst(App(x, y)))) : Implies<Implies<a, And<b, c>>, Implies<a, b>>

-- Expected failure: self-application proves no finite proposition.
fails Lam(p, App(p, p))  -- infinite type
